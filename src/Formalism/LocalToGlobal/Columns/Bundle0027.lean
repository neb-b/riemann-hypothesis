def tildeLatticeAgreement (u : d.what₂.Word) :
    CF.TilTied (D := d.colRec a) u (atTTied a hH u) (parabolicClassAgreement a hS hH hP u) (levelAgreement a hS hH u d.R.m le_rfl) where
  z0 := d.z0 u
