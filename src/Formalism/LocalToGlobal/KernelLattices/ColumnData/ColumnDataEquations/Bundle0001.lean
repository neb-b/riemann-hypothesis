  rw [pull_mul_left, h2, pull_smul, hI, h1, Iop_smulF, hT, smul_smul, Examples₂.smulLat_mul]
  congr 1
  rw [← mul_pow, ← Finset.prod_mul_distrib]
  congr 1
  refine Finset.prod_congr rfl fun τ _ => ?_
  rw [Matrix.det_mul, star_mul, map_mul]

