open NumberField IsDedekindDomain

abbrev Tau2 (R : Ranks) : Type := ↥(R.Psi)

theorem card_realPlaces_eq_degree (R : Ranks) : Fintype.card (Tau2 R) = R.f := by
  rw [← Nat.card_eq_fintype_card, R.toFrame.natCard_Psi]
  rfl

section Member2

