        Pairwise (Function.onFun Disjoint D) ∧
        (⋃ k, D k)ᶜ ⊆ {y | eval y P = 0} ∧
        volume (⋃ k, D k)ᶜ = 0 ∧
        (∀ k, ∀ y ∈ U k,
          ComplexSets.fibre J A y = Set.range (fun j => s k j y) ∧
          Function.Injective (fun j => s k j y) ∧
          ∀ j, IsSheetAt J A (s k j y) (s k j))

