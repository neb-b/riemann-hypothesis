def BranchImageNhdOffCentre.Statement : Prop :=
  ∀ (n : ℕ) (I : Ideal (MvPolynomial (Fin n) ℂ)) (q : Fin n → ℂ),
    ringKrullDim (curveLocalRing I q) = 1 →
      ∃ N ∈ 𝓝 q, ∀ c : VarBranch I 1 q, ∀ x ∈ c.image ∩ N, x ≠ q →
        ∃ U ∈ 𝓝 x, zeroSet I ∩ U ⊆ c.image

