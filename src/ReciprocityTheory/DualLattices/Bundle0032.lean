  isUnit_det_E := D.H.isUnit_det_E
  E_equivariant := D.H.E_equivariant
  projectors := D.H.projectors
  Ht := D.H.Ht
  Bt := D.H.Bt
  Ht_equivariant := D.H.Ht_equivariant
  form_eq_alt := D.H.form_eq_alt
  AA := D.hopf C hdom hinj hLat hHopf
