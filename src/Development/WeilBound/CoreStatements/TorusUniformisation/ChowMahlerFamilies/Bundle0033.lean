theorem finrank_eq_of_isVB {X : Scheme.{0}} {Ω : Type} [Field Ω] {ξ : Spec (CommRingCat.of Ω) ⟶ X}
    {Li : Type} [AddCommGroup Li] [Module Ω Li] {L : Lat ξ Li} {r : ℕ} {V : Submodule Ω Li} (h : L.IsVB r V)
    (q : Cpt ξ) : Module.finrank Ω V = r := by
