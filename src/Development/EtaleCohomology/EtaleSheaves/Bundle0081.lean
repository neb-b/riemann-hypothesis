theorem stalk_of_smoothAt {R A : CommRingCat.{0}} (φ : R ⟶ A) (p : PrimeSpectrum A)
    (h : letI := φ.hom.toAlgebra; Algebra.IsSmoothAt R p.asIdeal) :
