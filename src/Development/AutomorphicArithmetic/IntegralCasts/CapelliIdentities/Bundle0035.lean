        (IsUltrametricDist.norm_add_le_max a b).trans (max_le ha hb)
      zero_mem' := by
        show ‖(0 : ℂ_[p])‖ ≤ 1
        rw [norm_zero]
        exact zero_le_one
      neg_mem' := fun {a} ha => by
        show ‖-a‖ ≤ 1
        rw [norm_neg]
        exact ha }
