theorem blockCharConj_of_isTripleOf (h : _root_.GlobalTheory.Triple.IsGaloisTripleOfExpansion Z) : BlockCharConj Y := by
  obtain ⟨C, art, h⟩ := h
  intro i hi j b h1 h2 k hk v hv A hA t ht t' ht'
