  let a := _root_.UpperTheory.One.M.stageAOfSwitch trivial N l.a
    (by with_unfolding_all exact rep) (by with_unfolding_all exact e)
  with_unfolding_all
    exact reindexBase hD hcf hrep a (cusp N l.cusp)

