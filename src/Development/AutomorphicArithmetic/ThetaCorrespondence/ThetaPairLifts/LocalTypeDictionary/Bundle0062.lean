    by exact_mod_cast (ENNReal.toReal_pos hJ0 hJtop).ne', fun s Q P P' hP ea ed h g hg gx hgx T' => ?_⟩
  obtain ⟨hu, hcard⟩ := _root_.GlobalTheory.BotClassDict.classes_and_stabilisers A' X.rA' hX.is.rigA' hX.std' ea gx hgx
