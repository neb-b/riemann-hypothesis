  set F := pureTensorO W.ψ W.θ (neg A) WW (fun τ => -X.rA.s τ) X.rW.s X.rA.B X.rW.B (X.f t) P
  set ω' := (X.ω t).toSgn true
  have e : ∀ y, X.ω t (g, y) = ω' ((ofSgn true A).symm g, y) := fun y => by
