    have hA : c * (s.x ^ (s.eps / 5) * Real.log s.x ^ 2) ≤
        |c| * (s.x ^ (s.eps / 5) * Real.log s.x ^ 2) :=
      mul_le_mul_of_nonneg_right (le_abs_self c) hY
    have hB : c * Real.log s.x ≤ |c| * Real.log s.x :=
