open ValuativeRel Formalism.MainNotions.S.Loc GlobalTheory.HL MeasureTheory
open scoped Pointwise ENNReal Classical

namespace GlobalTheory.HL

theorem det_fromBlocks_swapCols {R n : Type} [CommRing R] [Fintype n] [DecidableEq n]
    (A B C D : Matrix n n R) :
    (Matrix.fromBlocks A B C D).det = (-1) ^ Fintype.card n * (Matrix.fromBlocks B A D C).det := by
  have h : Matrix.fromBlocks A B C D =
      Matrix.fromBlocks B A D C * (Matrix.fromBlocks (1 : Matrix n n R) 1 0 1 *
        Matrix.fromBlocks (1 : Matrix n n R) 0 (-1) 1 * Matrix.fromBlocks (1 : Matrix n n R) 1 0 1 *
        Matrix.fromBlocks (-1 : Matrix n n R) 0 0 1) := by
    simp [Matrix.fromBlocks_multiply]
  rw [h]
  simp only [Matrix.det_mul, Matrix.det_fromBlocks_zero₂₁, Matrix.det_fromBlocks_zero₁₂,
    Matrix.det_one, Matrix.det_neg, mul_one, one_mul]
  ring

theorem fromBlocks_updateRow_eq {R n : Type} [CommRing R] [Fintype n] [DecidableEq n]
    (Z Z' : Matrix n n R) (l : n) (a b c d : n → R) :
    ((Matrix.fromBlocks Z 0 0 Z').updateRow (Sum.inl l) (Sum.elim a b)).updateRow (Sum.inr l)
        (Sum.elim c d) =
      Matrix.fromBlocks (Z.updateRow l a) ((0 : Matrix n n R).updateRow l b)
        ((0 : Matrix n n R).updateRow l c) (Z'.updateRow l d) := by
  ext (i | i) (j | j) <;> by_cases h : i = l <;> simp [Matrix.updateRow_apply, h]

theorem det_updateRow_last_single {R : Type} [CommRing R] (r : ℕ)
    (Z : Matrix (Fin (r + 1)) (Fin (r + 1)) R) (t : R) :
    (Z.updateRow (Fin.last r) (Pi.single (Fin.last r) t)).det =
      t * (Z.submatrix Fin.castSucc Fin.castSucc).det := by
  rw [Matrix.det_succ_row _ (Fin.last r), Finset.sum_eq_single (Fin.last r)]
  · have : (Z.updateRow (Fin.last r) (Pi.single (Fin.last r) t)).submatrix
        (Fin.last r).succAbove (Fin.last r).succAbove =
        Z.submatrix Fin.castSucc Fin.castSucc := by
      ext i j
      simp [Matrix.updateRow_apply, Fin.succAbove_last, Fin.castSucc_ne_last]
    rw [this]
    simp [← two_mul, pow_mul]
  · intro b _ hb
    simp [Pi.single_apply, hb]
  · simp

theorem det_fromBlocks_rowBlocks {R n : Type} [CommRing R] [Fintype n] [DecidableEq n]
    (Z Z' : Matrix n n R) (l : n) (b c : n → R) :
    (Matrix.fromBlocks Z ((0 : Matrix n n R).updateRow l b)
        ((0 : Matrix n n R).updateRow l c) Z').det =
      Z.det * Z'.det - (Z.updateRow l c).det * (Z'.updateRow l b).det := by
  set F : (n ⊕ n → R) → (n ⊕ n → R) → R := fun u v =>
    (((Matrix.fromBlocks Z 0 0 Z').updateRow (Sum.inl l) u).updateRow (Sum.inr l) v).det with hF
  have hz : (0 : Matrix n n R).updateRow l 0 = 0 := by
    ext i j; simp [Matrix.updateRow_apply]
  have hz0 : ∀ X : Matrix n n R, (X.updateRow l 0).det = 0 := fun X =>
    Matrix.det_eq_zero_of_row_eq_zero l (by simp)
  have add2 : ∀ u v w, F u (v + w) = F u v + F u w := fun u v w => Matrix.det_updateRow_add _ _ _ _
  have add1 : ∀ u v w, F (u + v) w = F u w + F v w := fun u v w => by
    simp only [hF]
    have hne : (Sum.inl l : n ⊕ n) ≠ Sum.inr l := by simp
    rw [Matrix.updateRow_comm _ hne, Matrix.updateRow_comm _ hne, Matrix.updateRow_comm _ hne]
    exact Matrix.det_updateRow_add _ _ _ _
  have swap : ∀ u v, F u v = - F v u := fun u v => by
    simp only [hF]
    have hne : (Sum.inl l : n ⊕ n) ≠ Sum.inr l := by simp
    have : ((Matrix.fromBlocks Z 0 0 Z').updateRow (Sum.inl l) u).updateRow (Sum.inr l) v =
        (((Matrix.fromBlocks Z 0 0 Z').updateRow (Sum.inl l) v).updateRow (Sum.inr l) u).submatrix
          (Equiv.swap (Sum.inl l) (Sum.inr l)) id := by
      ext i j
      by_cases h1 : i = Sum.inl l
      · subst h1; simp [Matrix.updateRow_apply]
      · by_cases h2 : i = Sum.inr l
        · subst h2; simp [Matrix.updateRow_apply]
        · simp [Matrix.updateRow_apply, Equiv.swap_apply_of_ne_of_ne h1 h2, h1, h2]
    rw [this, Matrix.det_permute, Equiv.Perm.sign_swap hne]
    simp
  have val : ∀ a b c d : n → R, F (Sum.elim a b) (Sum.elim c d) =
      (Matrix.fromBlocks (Z.updateRow l a) ((0 : Matrix n n R).updateRow l b)
        ((0 : Matrix n n R).updateRow l c) (Z'.updateRow l d)).det := fun a b c d => by
    simp only [hF, fromBlocks_updateRow_eq]
  have e : ∀ a b : n → R, Sum.elim a b = Sum.elim a (0 : n → R) + Sum.elim (0 : n → R) b := by
    intro a b; ext (i | i) <;> simp
  have h0 := val (Z l) b c (Z' l)
  rw [Matrix.updateRow_eq_self, Matrix.updateRow_eq_self] at h0
  rw [← h0, e (Z l) b, e c (Z' l), add1, add2, add2, swap (Sum.elim 0 b) (Sum.elim c 0)]
  simp only [val, hz, Matrix.det_fromBlocks_zero₂₁, Matrix.det_fromBlocks_zero₁₂, hz0,
    Matrix.updateRow_eq_self]
  ring

theorem det_gram_two_frames {R : Type} [CommRing R] (r : ℕ)
    (Z Z' : Matrix (Fin (r + 1)) (Fin (r + 1)) R) (T T' : R) :
    (Matrix.fromBlocks (Matrix.single (Fin.last r) (Fin.last r) (-T)) Z Z'
      (Matrix.single (Fin.last r) (Fin.last r) (-T'))).det =
      (-1) ^ (r + 1) * (Z.det * Z'.det - T * T' *
        ((Z.submatrix Fin.castSucc Fin.castSucc).det *
          (Z'.submatrix Fin.castSucc Fin.castSucc).det)) := by
  have hs : ∀ t : R, Matrix.single (Fin.last r) (Fin.last r) t =
      (0 : Matrix (Fin (r + 1)) (Fin (r + 1)) R).updateRow (Fin.last r)
        (Pi.single (Fin.last r) t) := by
    intro t
    ext i j
    simp only [Matrix.updateRow_apply, Matrix.single_apply, Pi.single_apply, Matrix.zero_apply]
    by_cases hi : i = Fin.last r <;> by_cases hj : j = Fin.last r <;>
      simp [hi, hj, eq_comm]
  rw [det_fromBlocks_swapCols, hs, hs, det_fromBlocks_rowBlocks, det_updateRow_last_single,
    det_updateRow_last_single, Fintype.card_fin]
  ring

end GlobalTheory.HL
end

-- bundled from Development.AbelianVarietyTheory.Proofs.FlagMeasures.EichlerIsometry
section
open ValuativeRel Formalism.MainNotions.S.Loc GlobalTheory.HL MeasureTheory
open scoped Pointwise ENNReal Classical

namespace GlobalTheory.HL.Eichler

section
variable {F : Type} [Field F] [ValuativeRel F] [TopologicalSpace F]
variable {E : Type} [CommRing E] [Algebra F E] [TopologicalSpace E]
variable (L : LocE F E) {n : ℕ} (Hm : Matrix (Fin n) (Fin n) E)

theorem hf_add_l (a b y : Fin n → E) : hf L Hm (a + b) y = hf L Hm a y + hf L Hm b y := by
  simp [hf, add_mul, Finset.sum_add_distrib]

theorem hf_sub_l (a b y : Fin n → E) : hf L Hm (a - b) y = hf L Hm a y - hf L Hm b y := by
  simp [hf, sub_mul, Finset.sum_sub_distrib]

theorem hf_smul_l (c : E) (a y : Fin n → E) : hf L Hm (c • a) y = c * hf L Hm a y := by
  simp [hf, Finset.mul_sum, mul_assoc]

theorem hf_add_r (a b y : Fin n → E) : hf L Hm y (a + b) = hf L Hm y a + hf L Hm y b := by
  simp [hf, mul_add, Finset.sum_add_distrib]

theorem hf_sub_r (a b y : Fin n → E) : hf L Hm y (a - b) = hf L Hm y a - hf L Hm y b := by
  simp [hf, mul_sub, Finset.sum_sub_distrib]

theorem hf_neg_r (a y : Fin n → E) : hf L Hm y (-a) = - hf L Hm y a := by
  simp [hf, Finset.sum_neg_distrib]

theorem hf_neg_l (a y : Fin n → E) : hf L Hm (-a) y = - hf L Hm a y := by
  simp [hf, Finset.sum_neg_distrib]

theorem hf_smul_r (c : E) (a y : Fin n → E) : hf L Hm y (c • a) = L.cj c * hf L Hm y a := by
  simp only [hf, Finset.mul_sum, Pi.smul_apply, smul_eq_mul, map_mul]
  refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => by ring

theorem hf_cj {Hm : Matrix (Fin n) (Fin n) E} (h : IsHerm L Hm) (x y : Fin n → E) :
    L.cj (hf L Hm x y) = hf L Hm y x := by
  have h' : ∀ i j, L.cj (Hm j i) = Hm i j := fun i j => congrFun (congrFun h i) j
  set_option synthInstance.maxHeartbeats 100000 in
    simp only [hf, map_sum, map_mul, L.cj_cj, h']
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => by ring

def eichL (x u : Fin n → E) (s : E) : (Fin n → E) →ₗ[E] (Fin n → E) where
  toFun := eich L Hm x u s
  map_add' a b := by
    simp only [eich, hf_add_l]; module
  map_smul' c a := by
    simp only [eich, hf_smul_l, RingHom.id_apply]; module

theorem eich_inv {Hm : Matrix (Fin n) (Fin n) E} (h : IsHerm L Hm) (x u : Fin n → E) (s : E)
    (hx : hf L Hm x x = 0) (hu : hf L Hm u x = 0) (hs : s + L.cj s = hf L Hm u u) (v : Fin n → E) :
    eich L Hm x (-u) (L.cj s) (eich L Hm x u s v) = v := by
  have hu' : hf L Hm x u = 0 := by rw [← hf_cj L h, hu, map_zero]
  simp only [eich, hf_add_l, hf_sub_l, hf_smul_l, hf_neg_r, hx, hu, hu', ← hs]
  module

theorem eich_isom {Hm : Matrix (Fin n) (Fin n) E} (h : IsHerm L Hm) (x u : Fin n → E) (s : E)
    (hx : hf L Hm x x = 0) (hu : hf L Hm u x = 0) (hs : s + L.cj s = hf L Hm u u) (v w : Fin n → E) :
    hf L Hm (eich L Hm x u s v) (eich L Hm x u s w) = hf L Hm v w := by
  have hu' : hf L Hm x u = 0 := by rw [← hf_cj L h, hu, map_zero]
  simp only [eich, hf_add_l, hf_sub_l, hf_smul_l, hf_add_r, hf_sub_r, hf_smul_r, hx, hu, hu', ← hs,
    hf_cj L h]
  ring

end

theorem eichler_isometry : ∀ {F : Type} [Field F] [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F] {E : Type} [CommRing E] [Algebra F E] [TopologicalSpace E] (L : LocE F E), ∀ {n : ℕ} (Hm : Matrix (Fin n) (Fin n) E), IsHermND L Hm → ∀ (x u : Fin n → E) (s : E), hf L Hm x x = 0 → hf L Hm u x = 0 → s + L.cj s = hf L Hm u u → ∃ g ∈ isomG L Hm, (∀ v, g v = eich L Hm x u s v) ∧ ∀ v, g⁻¹ v = eich L Hm x (-u) (L.cj s) v := by
  intro F _ _ _ _ _ E _ _ _ L n Hm hH x u s hx hu hs
  have h1 := eich_inv L hH.1 x u s hx hu hs
  have h2 := eich_inv L hH.1 x (-u) (L.cj s) hx (by rw [hf_neg_l, hu, neg_zero])
    (by rw [L.cj_cj, hf_neg_l, hf_neg_r, neg_neg, add_comm, hs])
  simp only [neg_neg, L.cj_cj] at h2
  refine ⟨{ eichL L Hm x u s with
      invFun := eich L Hm x (-u) (L.cj s)
      left_inv := h1
      right_inv := h2 }, ?_, fun _ => rfl, fun _ => rfl⟩
  exact fun v w => eich_isom L hH.1 x u s hx hu hs v w

end GlobalTheory.HL.Eichler
end

-- bundled from Development.AbelianVarietyTheory.Proofs.FlagMeasures.WittFreeTuplesFin
section
open GlobalTheory.SgAlg Matrix

namespace GlobalTheory

theorem witt_free_tuples_fin {E : Type} [CommRing E] (σ : E →+* E) (hσ : IsQA σ) {n k : ℕ}
    (J : Matrix (Fin n) (Fin n) E) (hJ : IsHermU σ J) (Y Y' : Matrix (Fin n) (Fin k) E)
    (hY : Free Y) (hY' : Free Y') (hP : pairM σ J Y Y = pairM σ J Y' Y') :
    ∃ g, IsUn σ J g ∧ g * Y = Y' := by
  rcases GlobalTheory.T.isField_or_exists_swapped_idempotent_of_quadraticEtale σ hσ with hF | hS
  · letI := hF.toField
    exact _root_.GlobalTheory.SgAlg.witt_free_field σ hσ J hJ Y Y' hY hY' hP
  · exact _root_.GlobalTheory.SgAlg.WittSplit.witt_split σ hσ hS J hJ Y Y' hY hY' hP

theorem free_reindex {E : Type} [CommRing E] {n : ℕ} {a b : Type} [Fintype a] [DecidableEq a]
    [Fintype b] [DecidableEq b] (e : b ≃ a) {X : Matrix (Fin n) a E} (hX : Free X) :
    Free (X.submatrix id e) := by
  obtain ⟨L, hL⟩ := hX
  refine ⟨L.submatrix e id, ?_⟩
  have h : L.submatrix e id * X.submatrix id e = (L * X).submatrix e e := by
    ext i j
    simp [Matrix.mul_apply]
  rw [h, hL]
  simp

theorem pairM_reindex {E : Type} [CommRing E] (σ : E →+* E) {n : ℕ} {a b : Type} [Fintype a]
    (e : b ≃ a) (J : Matrix (Fin n) (Fin n) E) (X X' : Matrix (Fin n) a E) :
    pairM σ J (X'.submatrix id e) (X.submatrix id e) = (pairM σ J X' X).submatrix e e := by
  ext i j
  simp [pairM, cT, Matrix.mul_apply]

theorem witt_free_tuples {E : Type} [CommRing E] (σ : E →+* E) (hσ : IsQA σ) {n : ℕ} {a : Type}
    [Fintype a] [DecidableEq a] (J : Matrix (Fin n) (Fin n) E) (hJ : IsHermU σ J)
    (X X' : Matrix (Fin n) a E) (hX : Free X) (hX' : Free X')
    (hP : pairM σ J X X = pairM σ J X' X') : ∃ g, IsUn σ J g ∧ g * X = X' := by
  let e : Fin (Fintype.card a) ≃ a := (Fintype.equivFin a).symm
  obtain ⟨g, hg, hgX⟩ := witt_free_tuples_fin σ hσ J hJ (X.submatrix id e) (X'.submatrix id e)
    (free_reindex e hX) (free_reindex e hX')
    (by rw [pairM_reindex, pairM_reindex, hP])
  refine ⟨g, hg, ?_⟩
  ext i j
  have h := congrFun (congrFun hgX i) (e.symm j)
  simpa [Matrix.mul_apply] using h

end GlobalTheory
end

