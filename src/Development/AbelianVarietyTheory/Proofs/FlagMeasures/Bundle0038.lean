  have hV : p ^ 2 • v ∈ Λ := by
    rw [← eich_inv L hH x u s hx hu hs v]
    generalize eich L Hm x u s v = w at hv
    have e : p ^ 2 • eich L Hm x (-u) (L.cj s) w = p ^ 2 • w - (p * hf L Hm w u) • (p • x)
