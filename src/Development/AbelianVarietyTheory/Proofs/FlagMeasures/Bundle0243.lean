      = ((2 : ℝ) ^ f * (2⁻¹ : ℝ) ^ f) * (d ^ (1 / 2 - 2 * (t : ℝ)) * c ^ f) := by ring
    _ = d ^ (1 / 2 - 2 * (t : ℝ)) * c ^ f := by rw [h2, one_mul]

