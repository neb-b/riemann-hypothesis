    have hnF : (n : F) ≠ 0 := Int.cast_ne_zero.mpr hn
    have := (Submodule.span F (((c : Submodule (𝓞 E) E).restrictScalars (𝓞 F)) : Set E)).smul_mem (n : F)⁻¹ hs
    simpa [smul_smul, hnF] using this
