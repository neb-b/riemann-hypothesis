  obtain ⟨e, b, he, -, hb, heq⟩ := satBasisV_holds F E _ hfull 1 w w.linearIndependent (fun _ => 1)
    (fun _ => one_ne_zero)
  refine ⟨e, b, he, hb, ?_⟩
  rw [← heq, w.span_eq]
