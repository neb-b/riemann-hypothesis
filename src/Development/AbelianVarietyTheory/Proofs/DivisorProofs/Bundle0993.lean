    ⟨1, 1, fun y => ?_⟩, fun f y => rfl⟩
  have := GlobalTheory.ExtendByZero.norm_le_norm_clm (V := mixedEmbedding.mixedSpace F) hj y
  simp only [pow_one, one_mul]
