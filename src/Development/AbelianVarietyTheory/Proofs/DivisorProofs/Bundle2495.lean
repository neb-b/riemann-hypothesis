      (fun I => JQ ((p ≫ β₂R) ≫ lamφ Q.B I)) (fun I => J' (p ≫ lamφ D.P.A I))
      (Set.mem_iInter.2 fun I => hJ (p ≫ (β₂R ≫ β₂Q) ≫ lamφ T.B I))
