  haveI := hs.to_subtype
  obtain ⟨m, ⟨e⟩⟩ := Finite.exists_equiv_fin s
  refine ⟨m, fun k => (e.symm k).1, fun k => ⟨(e.symm k).1.regSet, (e.symm k).1.isOpen_regSet⟩,
    fun k => fun a ha => RatModel.mem_ringOn.2 fun z hz => hz ha, fun x => ?_⟩
