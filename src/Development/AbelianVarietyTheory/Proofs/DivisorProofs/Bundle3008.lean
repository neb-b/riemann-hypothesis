  have key : ∀ Y : USetup C, Y = X'' → ∃ w ∈ Y.regSet, Y.π w = C.i x := by
    rintro Y rfl
    exact ⟨w, hw, he⟩
  exact ⟨e ⟨X'', hX⟩, key _ (by simp)⟩

