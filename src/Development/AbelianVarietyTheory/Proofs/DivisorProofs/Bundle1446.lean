theorem isOpen_isCompact_KK (a b : ℕ) (w : Pl E) :
    IsOpen (((GlobalTheory.LFun.KGL w (n := a)).prod (GlobalTheory.LFun.KGL w (n := b)) : Subgroup (GLw a w × GLw b w)) : Set (GLw a w × GLw b w)) ∧
