  congr 2
  have h4 : β (z * b⁻¹) x = β (x * b⁻¹) z := by rw [hbi, hs]
  simp only [Matrix.add_mul, Matrix.mul_neg, map_add (f := _), map_neg, LinearMap.add_apply, LinearMap.neg_apply, h4, ← hbi z z]
  ring

