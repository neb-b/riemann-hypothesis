theorem singleSeries_hasType (hθ : IsInfFam R.θ) {χS χT : (AE D)ˣ →* Circle} {ω : WeilRep D i}
    {φ : WO (Vc D i) (Wc D i) → ℂ} (hω : IsWeilDatumO R.ψ (Vc D i) (Wc D i) χS χT ω)
    (hφ : IsThetaFunO R.ψ (Vc D i) (Wc D i) φ)
