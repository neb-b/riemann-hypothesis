  obtain ⟨πC, hπ, hab⟩ := hch C hC ξ hξ tK a b
  have hactC := _root_.GlobalTheory.UChart.act_chart_compat C.t G ξ πC hsemi hπ act tK a (b.φ ≫ e) (fun u => by
