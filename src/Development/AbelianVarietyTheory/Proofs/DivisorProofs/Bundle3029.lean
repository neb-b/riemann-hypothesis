  have adj := _root_.GlobalTheory.ExtAdj.adj_extends Xo c φ hpq hfan hns zs i OZ N d J π j BD hU hPre tF mF G e hsemi he hch act hact PP cub cm
    hcm hce hlin
  have prim := _root_.GlobalTheory.PrimExt.lbIso_prim_ext Xo c φ hpq hfan hns zs i OZ N d J π j BD hU hPre tF mF G e hsemi he hch act hact PP cub cm
