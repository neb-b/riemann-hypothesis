  obtain ⟨n₁, hn₁, h₁⟩ := _root_.GlobalTheory.exists_pos_nat_smul_mem_of_fg_of_span_eq_top X.Λ Λ' hfg X.Λ_span
  obtain ⟨n₂, hn₂, h₂⟩ := _root_.GlobalTheory.exists_pos_nat_smul_mem_of_fg_of_span_eq_top Λ' X.Λ X.Λ_fg hsp
