      letI := b'.invertibleToMatrix c
      exact Matrix.isUnit_det_of_invertible _
    rw [hD, Matrix.det_mul, Matrix.det_mul, Subring.coe_mul, Subring.coe_mul,
      v.map_mul, v.map_mul, v_unit v hu, add_zero, hrA, hrB]
    simp

