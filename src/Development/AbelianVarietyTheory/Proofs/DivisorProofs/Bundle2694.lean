      exact hP.dbar z hz hzO
    · rintro _ ⟨z, hz, rfl⟩
      exact (_root_.GlobalTheory.GoodTop.contDiffAt_holoChart hP.holo (hP.sub hz) (hρ z)).contDiffWithinAt
    · rintro _ ⟨z, hz, rfl⟩ hK
