            MvPolynomial.pderiv ⟨w, l⟩ (θ T) := by
  intro W _ _ Λ
  refine ⟨polMapD W Λ, polMapD_injective W Λ, fun w l T => ⟨?_, ?_⟩⟩
  · exact LinearMap.congr_fun (polMapD_atPl_mulLeft_X W Λ w l) T
  · exact LinearMap.congr_fun (polMapD_atPl_pderiv W Λ w l) T

