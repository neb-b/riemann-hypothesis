      exact conj_mul_star (starT G.star (AfP p)) (inC G (AfP p) (β : G.C)) x z.1 t (z.2 : AfP p) hx hT.1
    let g : G.GAf := ⟨psiAway G x z, hw⟩
    have hg : g ∈ K' := by
