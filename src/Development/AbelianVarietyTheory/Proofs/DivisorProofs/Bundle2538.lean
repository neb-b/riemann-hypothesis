            ((l ((a₂ ≫ f) * (b₂ ≫ g)) * (l (a₂ ≫ f))⁻¹ * (l (b₂ ≫ g))⁻¹ * l 1) *
              (k (a₂ * b₂) * (k a₂)⁻¹ * (k b₂)⁻¹ * k 1)⁻¹)) =
