  have e₁ := congrArg (fun q => q.left) (k₁ z)
  have e₂ := congrArg (fun q => q.left) (k₂ z)
  refine e₂.symm.trans (Eq.trans ?_ e₁)
  refine (f₂ z).symm.trans (Eq.trans ?_ (f₁ z))
  rw [← hm₀ z, Category.assoc, ← hk, ← hk', hφ]
