    rw [hasTh_iff] at hH ⊢
    refine (_root_.GlobalTheory.UMin.ThMove.hasTh₂_move _ P.A P.L rig P.isLB hrig (Sp K) Q.A Q.L rigQ y α Q.isLB hrigQ hpb hQL (ℓ ^ j) (ℓ ^ j)
      (N + 1) (N + 1) K (𝟙 _) cy cy).2 ?_
