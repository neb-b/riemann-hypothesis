    letI : Algebra K⟮b⟯ ℂ := ψ.toRingHom.toAlgebra
    obtain ⟨Q⟩ := GlobalTheory.nonempty_algHom_complex_of_countable K⟮b⟯ Ω
    let P : Ω →ₐ[K] ℂ := { Q.toRingHom with
      commutes' := fun k => (Q.commutes (algebraMap K K⟮b⟯ k)).trans (ψ.commutes k) }
    rw [← h P]
