  have e2 : α ≫ β = 𝟙 B := by
    rw [← cancel_mono α, Category.assoc, e1, Category.comp_id, Category.id_comp]
  refine ⟨β, ⟨⟨α, e1, e2⟩⟩, hβ, ?_⟩
  rw [← hαeq, Category.assoc, e2, Category.comp_id]

