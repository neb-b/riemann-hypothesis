      intro v hv
      exact ((flL_det_contDiffAt ((h2 v hv).contDiffAt (hSo.mem_nhds hv))).differentiableAt
        (by simp)).differentiableWithinAt
    refine h3.congr fun v hv => ?_
    simp only [Function.comp_apply, jdet, jz, (A.chart i).right_inv hv.1]
  · have hyt : A.chart i y ∈ (A.chart i).target := (A.chart i).map_source hi
    have hov : IsOpen (ovl A.chart i j) :=
      (A.chart i).isOpen_inter_preimage_symm (A.chart j).open_source
    have hmov : A.chart i y ∈ ovl A.chart i j := ⟨hyt, by simp [(A.chart i).left_inv hi, hj]⟩
    have hτ : DifferentiableAt ℂ (A.chart j ∘ (A.chart i).symm) (A.chart i y) :=
      (A.holo_trans i j).differentiableAt (hov.mem_nhds hmov)
    have hτy : (A.chart j ∘ (A.chart i).symm) (A.chart i y) = A.chart j y := by
      simp [(A.chart i).left_inv hi]
    have hSo : IsOpen ((A.chart j).target ∩ (A.chart j).symm ⁻¹' U) :=
      (A.chart j).isOpen_inter_preimage_symm hz.isOpen
    have hmj : A.chart j y ∈ (A.chart j).target ∩ (A.chart j).symm ⁻¹' U :=
      ⟨(A.chart j).map_source hj, by simp [(A.chart j).left_inv hj, hy]⟩
    have hzj : DifferentiableAt ℂ (z ∘ (A.chart j).symm) ((A.chart j ∘ (A.chart i).symm) (A.chart i y)) := by
      rw [hτy]; exact (hz.holo j).differentiableAt (hSo.mem_nhds hmj)
    have hev : z ∘ (A.chart i).symm =ᶠ[𝓝 (A.chart i y)]
        (z ∘ (A.chart j).symm) ∘ (A.chart j ∘ (A.chart i).symm) := by
      filter_upwards [hov.mem_nhds hmov] with v hv
      simp only [Function.comp_apply, (A.chart j).left_inv hv.2]
    have hjz : jz A z i y = (jz A z j y).comp (fderiv ℂ (A.chart j ∘ (A.chart i).symm) (A.chart i y)) := by
      unfold jz
      rw [hev.fderiv_eq, fderiv_comp _ hzj hτ, hτy]
    simp only [jdet]
    rw [hjz, A.g_kap i j y hi hj]
    exact (LinearMap.det_comp _ _).trans (mul_comm _ _)

end GlobalTheory.OTY
end

-- bundled from Development.AbelianVarietyTheory.Proofs.DivisorProofs.KatzQuasiIntegralCriterion
section
open CategoryTheory TensorProduct MvPowerSeries GlobalTheory GlobalTheory.PDiv GlobalTheory.PDivGroup GlobalTheory.Katz

namespace GlobalTheory.Katz

theorem quasiInt_of_cob1_int_of_lin_int : ∀ (p : ℕ) [Fact p.Prime] (k : Type) [Field k] [CharP k p] [PerfectRing k p] (d : ℕ) (μ : Fin d → MvPowerSeries (Fin d ⊕ Fin d) k), IsLaw μ → ∀ f : MvPowerSeries (Fin d) (Fr p k), (∀ i, ∃ w : WittVector p k, lin f i = algebraMap (WittVector p k) (Fr p k) w) → cob1 (fun i => Katz.lift p (μ i)) f ∈ intBy p k _ 1 → f ∈ quasiInt p k (Fin d) := by
  intro p _ k _ _ _ d μ hμ f hlin hcob
  have key : ∀ N, ∀ α : Fin d →₀ ℕ, α.degree = N → ∀ i, ∃ w : WittVector p k,
      (α i : Fr p k) * coeff α f = algebraMap (WittVector p k) (Fr p k) w := by
    intro N
    induction N using Nat.strong_induction_on with
    | _ N ih =>
      intro α hα i
      rcases Nat.lt_or_ge N 2 with hN | hN
      · interval_cases N
        · have h0 : α = 0 := (Finsupp.degree_eq_zero_iff α).1 hα
          subst h0
          exact ⟨0, by simp⟩
        · by_cases hi : α i = 0
          · exact ⟨0, by simp [hi]⟩
          · have hα' : α ∈ Set.range (fun a : Fin d ↦ Finsupp.single a 1) := by
              rw [Finsupp.range_single_one]; exact hα
            obtain ⟨a, rfl⟩ := hα'
            have hai : a = i := by
              by_contra hne
              exact hi (Finsupp.single_eq_of_ne (Ne.symm hne))
            subst hai
            obtain ⟨w, hw⟩ := hlin a
            refine ⟨w, ?_⟩
            simp only [Finsupp.single_eq_same, Nat.cast_one, one_mul]
            exact hw
      · let g : MvPowerSeries (Fin d) (Fr p k) := fun β => if β.degree < N then coeff β f else 0
        have hg : ∀ β, coeff β g = if β.degree < N then coeff β f else 0 := fun β => rfl
        have hgq : g ∈ quasiInt p k (Fin d) := by
          show ∀ (β : Fin d →₀ ℕ) (j : Fin d), ∃ w : WittVector p k,
            (β j : Fr p k) * coeff β g = algebraMap _ (Fr p k) w
          intro β j
          by_cases hβ : β.degree < N
          · obtain ⟨w, hw⟩ := ih β.degree hβ β rfl j
            refine ⟨w, ?_⟩
            rw [hg, if_pos hβ]; exact hw
          · exact ⟨0, by rw [hg, if_neg hβ]; simp⟩
        have hh : ∀ β : Fin d →₀ ℕ, β.degree < N → coeff β (f - g) = 0 := by
          intro β hβ
          rw [map_sub, hg, if_pos hβ, sub_self]
        have hc : ∀ γ : Fin d ⊕ Fin d →₀ ℕ, γ.degree = N → ∃ w : WittVector p k,
            coeff γ (cob1 (fun i => Katz.lift p (μ i)) (g + (f - g))) =
              algebraMap (WittVector p k) (Fr p k) w := by
          intro γ _
          rw [add_sub_cancel]
          obtain ⟨w, hw⟩ := hcob γ
          exact ⟨1 * w, hw⟩
        obtain ⟨w, hw⟩ := _root_.GlobalTheory.Katz.WDer.main p k d μ hμ N g (f - g) hN hgq hh hc α i hα
        refine ⟨w, ?_⟩
        have hfα : coeff α (f - g) = coeff α f := by
          rw [map_sub, hg, if_neg (by omega), sub_zero]
        rw [← hfα]; exact hw
  show ∀ (α : Fin d →₀ ℕ) (i : Fin d), ∃ w : WittVector p k,
    (α i : Fr p k) * coeff α f = algebraMap _ (Fr p k) w
  intro α i
  exact key _ α rfl i

end GlobalTheory.Katz
end

