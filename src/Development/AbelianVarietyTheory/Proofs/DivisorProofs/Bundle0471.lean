    obtain ⟨Φ', hΦ', hΦ'f⟩ := _root_.GlobalTheory.RankChart.exists_mem_nsp_eq_of_rank_le k (Fin ρ) (↥(Set.range S)ᶜ) (Fin d) ν ϖ hϖ hν τ
      (fun Z => f (Z.submatrix e'.symm id)) (hT.1 f hf) (fun Z hZ => by
