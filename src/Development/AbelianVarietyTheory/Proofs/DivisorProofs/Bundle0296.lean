  refine ⟨k, fun g => ?_⟩
  have h5 : g * Pi.single k 1 = g k • (Pi.single k 1 : ι → O) := by
    funext j
    by_cases hj : j = k
    · subst hj; simp
    · simp [hj]
  have h6 := congrArg f h5
  rwa [map_mul, map_smul, h4, mul_one, smul_eq_mul, mul_one] at h6

