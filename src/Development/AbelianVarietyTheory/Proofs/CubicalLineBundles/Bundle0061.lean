    constructor
    · intro h Z r z j k hj hk
      have hz : r z ∈ (L.pull F).U (fun _ => j) ⊓ L'.U k := ⟨mem_pull.2 hj, hk⟩
      have a := congrArg (gs r z _) (h (fun _ => j) k)
