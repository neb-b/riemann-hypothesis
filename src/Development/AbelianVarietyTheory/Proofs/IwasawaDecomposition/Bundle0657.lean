      ⟨hP.arith.1, hP.arith.2.1, hP.arith.2.2.1, hlev⟩
    exact ⟨L, ⟨M.params⟩⟩
  · obtain ⟨L, e1, -, -, e4⟩ := hx0 K.s (withLoc Lc) (fun t => K.a t.1) (fun t => K.b t.1) hs ((le_max_left _ _).trans hx)
