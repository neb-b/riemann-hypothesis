theorem jWu_heq : HEq (jWu Z u) Z.jW := by exact_by_kernel (HEq.refl Z.jW)

theorem eRRu_heq : HEq (eRRu Z u) Z.eRR := by exact_by_kernel (HEq.refl Z.eRR)

