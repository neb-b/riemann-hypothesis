    rw [nsmul_eq_mul, mul_left_comm, h r c, ← nsmul_eq_mul]

theorem sb_step {Y : Type} [AddCommGroup Y] (Λ : AddSubgroup Y) (hf : Y → Prop) (Φ : Y → ℂ) (k : ℕ)
