  have key := (GlobalTheory.AdForm.rd_charts I hI hP l Z u a Ch A hA θ hθ j hj φ hφ).2 (A.chOf j ((I.stp u a j).cl c.1 d)) y α hαQ
    ⟨(I.stp u a j).cl c.1 d, rfl⟩ ai⁻¹ (inv_mem hai) ⟨_, hU⟩ y' hTr
  rw [hdec, key, hchiA]
  exact congrArg₂ (· * ·) hchi rfl
