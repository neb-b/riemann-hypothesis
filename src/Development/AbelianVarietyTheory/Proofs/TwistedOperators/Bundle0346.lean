      (finMat D.sp.cm.sig V.gram (GlobalTheory.AdelicU.emb D.sp.cm.sig V.gram v k)).mulVec y ∈
        latHat D.host.F D.host.E (L : Set (Fin V.rank → D.host.E)) := by
