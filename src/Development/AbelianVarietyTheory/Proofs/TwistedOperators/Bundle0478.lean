    (fun τ => ⟨(m' τ).1, (m' τ).2.1⟩) (fun τ => ⟨(m τ).1, (m τ).2.1⟩) J0
    (fun _ _ _ => totalDegree_polAct _ _ _ _ _ _ _) (fun _ _ _ => totalDegree_polAct _ _ _ _ _ _ _)
