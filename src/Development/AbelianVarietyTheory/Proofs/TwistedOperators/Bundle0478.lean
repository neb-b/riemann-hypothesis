  have m := fun τ => _root_.GlobalTheory.CompactModel.model_allPos D (G.Xp j).V _ (G.Xp j).M τ (hε τ)
  have m' := fun τ => _root_.GlobalTheory.CompactModel.model_allPos D (G.nX j).V _ (G.nX j).M τ (hε' τ)
  have hl := fun τ =>
