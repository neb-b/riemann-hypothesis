  have h1 : ∀ a b, dualTens E a b (dualTens E b a x) i
      = E a b (E b a (x i)) - (if i = a then E a b (x b) else 0)
        - (if i = b then E b a (x a) else 0) + (if i = b then x b else 0) := by
    intro a b
