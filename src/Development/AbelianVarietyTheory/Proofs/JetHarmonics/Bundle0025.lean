      _ = t := by simp
  refine ⟨fun i => P.coeff i, fun u => ?_⟩
  have hcomm : ∀ (p : Polynomial A) (k : ℕ),
      Commute ((RingHom.id A) (p.coeff k)) (algebraMap ℂ A u) := fun p k =>
    Algebra.commute_algebraMap_right u _
