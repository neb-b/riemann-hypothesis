    rw [e1, e2, e3, cst_comp, cst_comp, hb i]
    rfl
  · show ∑ i, resTop _ (scal D.toPre.P.A.hom (ϖ * b i)) * (σ i).f j =
      resTop _ (scal D.toPre.P.A.hom ϖ) * ∑ i, resTop _ (scal D.toPre.P.A.hom (b i)) * (σ i).f j
    rw [Finset.mul_sum]
