  choose a c hac using fun t => GlobalTheory.GeoFix.exists_lau_approx p K (b t)
  refine ⟨a, ∑ t, e t * ψ (c t), IsIntegral.sum _ fun t _ => (he t).mul (hψ (c t)), ?_⟩
  rw [← Finset.sum_sub_distrib, Finset.mul_sum]
