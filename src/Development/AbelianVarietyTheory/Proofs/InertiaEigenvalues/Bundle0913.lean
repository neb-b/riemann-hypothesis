  by_cases hij : i = j
  · subst hij
    rw [Matrix.one_apply_eq, Matrix.one_apply_eq, map_one, map_one]
    rfl
  · rw [Matrix.one_apply_ne hij, Matrix.one_apply_ne hij, RingHom.map_zero]
    exact congrArg (fun x : FiniteAdeleRing (𝓞 D.host.E) D.host.E => x Q) (map_zero ι)

