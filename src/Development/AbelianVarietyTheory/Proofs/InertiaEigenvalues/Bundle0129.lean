    intro g hg x
    set_option synthInstance.maxHeartbeats 100000 in
      rw [havg, map_smul, map_sum]
    congr 1
    simp_rw [← W.γD_mul T]
    conv_rhs => rw [← himage g hg]
    rw [Finset.sum_image (fun a _ c _ h => mul_left_cancel h)]
