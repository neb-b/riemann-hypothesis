  have hbij := (Module.End.isUnit_iff f).1 hunit
  refine ⟨b.map (LinearEquiv.ofBijective f hbij), fun k => ?_⟩
  rw [Module.Basis.map_apply, LinearEquiv.ofBijective_apply, hf]
  exact ⟨hN _ (b k).2, fun δ hδ => hinv δ hδ _⟩

