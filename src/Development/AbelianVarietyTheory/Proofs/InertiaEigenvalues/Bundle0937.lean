    have hdiv := hT2.div hH hH0
    have hev : ∀ᶠ x in 𝓝[>] (1 : ℝ), ((x - 1 : ℝ) : ℂ) * thetaZ μ 𝓕 ℓ φ.1 φ.1 Φ J η x / ((H x : ℝ) : ℂ) =
