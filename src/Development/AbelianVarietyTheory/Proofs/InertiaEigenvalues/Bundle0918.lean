  show om (s * z, g) (stdF ψ θ V W sW BW f Q) 0 = om (h, g) (om (a, 1) (stdF ψ θ V W sW BW f Q)) 0
  rw [e1, Module.End.mul_apply, Module.End.mul_apply, hk1, Module.End.mul_apply,
    hω.om_aut _ γ.2 1 (one_mem _) _ hth]

