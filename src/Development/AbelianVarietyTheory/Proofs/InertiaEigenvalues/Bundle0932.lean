    (hv : ∀ m, ∃ q : ℚ, AddMonoidAlgebra.coeff (v : Pol D.what₂.LL D.what₂.Tau (Vc D j).rank) m = (q : D.what₂.LL))
    (k : Subfield ℂ) : c0 v ∈ GlobalTheory.IndefiniteRowSideFullHecke.RationalRayLevels.ratVec R j c0 k := by
