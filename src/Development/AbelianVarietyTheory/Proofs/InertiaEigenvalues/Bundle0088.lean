    simp only [inv_one, Units.val_one]
    exact ⟨norm_one_apply_le_one i j, norm_one_apply_le_one i j⟩
  inv_mem' {a} ha := by
    intro i j
    rw [inv_inv]
    exact ⟨(ha i j).2, (ha i j).1⟩

