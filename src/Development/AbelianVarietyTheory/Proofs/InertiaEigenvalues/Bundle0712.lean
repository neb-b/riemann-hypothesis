  rw [Submodule.map_span, Submodule.map_top, ← Set.range_comp] at hs
  refine Eq.trans ?_ hs
  congr 2
  funext j
  ext a <;> simp [φ, Matrix.mulVec, dotProduct, Pi.single_apply]

end GlobalTheory.SWLagTerms.LagrangianFrames
