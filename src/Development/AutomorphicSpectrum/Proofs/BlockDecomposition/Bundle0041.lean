theorem updateRow_submatrix_eq {K ι κ : Type} [DecidableEq ι] [DecidableEq κ]
    (U : Matrix ι κ K) (s : κ → ι) (k : κ) (i : ι) :
    (U.submatrix s id).updateRow k (U i) = U.submatrix (Function.update s k i) id := by
