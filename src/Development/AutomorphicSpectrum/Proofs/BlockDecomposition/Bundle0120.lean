      isClosed_eq (continuous_subtype_val.matrix_elem _ _) continuous_const

theorem lAct_topEmbR (e : c ⊕ d ≃ b) {κ : ℕ}
    (y : RankIn (k := k) (a := a) (b := c) {κ}) (p : parab k (two e)) :
