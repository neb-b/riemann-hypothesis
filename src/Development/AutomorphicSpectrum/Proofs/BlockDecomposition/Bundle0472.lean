  intro Q h h1 C c hc s hs
  classical
  have hC : 0 ≤ C := by
    have h2 := (hc 1 le_rfl).2
    have h3 : (0:ℝ) ≤ (Set.ncard {q | h q ≤ 1} : ℝ) := Nat.cast_nonneg _
    simp only [one_pow, mul_one] at h2
