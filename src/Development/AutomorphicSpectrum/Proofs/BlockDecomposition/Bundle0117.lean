        a • mon K (m.1 + g) ((cone S : AddSubmonoid (Gam n d)).add_mem m.2 hg) := by
      simp only [mon, AddMonoidAlgebra.single_mul_single, mul_one, AddMonoidAlgebra.smul_single, smul_eq_mul]
