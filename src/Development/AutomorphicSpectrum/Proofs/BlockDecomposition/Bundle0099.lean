theorem tail_sum_finset_prod_two_mul_div_sq :
    ∀ (F : Type) [Field F] [NumberField F] (C : ℝ), 0 ≤ C → ∀ η : ℝ, 0 < η →
      ∃ T₀ : Finset (HeightOneSpectrum (𝓞 F)), ∀ T, T₀ ⊆ T →
        ∀ U : Finset (HeightOneSpectrum (𝓞 F)),
          ∑ D ∈ U.powerset with ¬ D ⊆ T,
            ∏ v ∈ D, (2 * C / (Ideal.absNorm v.asIdeal : ℝ) ^ 2) ≤ η := by
  intro F _ _ C hC η hη
  set a : HeightOneSpectrum (𝓞 F) → ℝ := fun v => 2 * C / (Ideal.absNorm v.asIdeal : ℝ) ^ 2
    with ha_def
  have ha0 : ∀ v, 0 ≤ a v := fun v => by
    simp only [ha_def]
    positivity
  have hsum : Summable a := by
    refine ((GlobalTheory.CompanionTheory.SW.Primes.summable_one_div_absNorm_sq F).mul_left (2 * C)).congr fun v => ?_
    simp only [ha_def, mul_one_div]

  set S := ∑' v, a v with hS
  have hexpS : 0 < Real.exp S := Real.exp_pos S
  have hq : 0 < η / Real.exp S := div_pos hη hexpS
  set ε := Real.log (1 + η / Real.exp S) with hε_def
  have hε : 0 < ε := Real.log_pos (by linarith)
  have hexpε : Real.exp ε = 1 + η / Real.exp S := Real.exp_log (by linarith)
  obtain ⟨T₀, hT₀⟩ := hsum.vanishing (Iio_mem_nhds hε)
  refine ⟨T₀, fun T hT U => ?_⟩

  have hsplit := Finset.sum_filter_add_sum_filter_not U.powerset (fun D => D ⊆ T)
    (fun D => ∏ v ∈ D, a v)
  have hin : U.powerset.filter (fun D => D ⊆ T) = (U ∩ T).powerset := by
    ext D
    simp only [Finset.mem_filter, Finset.mem_powerset, Finset.subset_inter_iff]
  rw [hin, ← Finset.prod_one_add, ← Finset.prod_one_add] at hsplit
  have hUT := Finset.prod_inter_mul_prod_sdiff U T (fun v => 1 + a v)
  have key : ∑ D ∈ U.powerset with ¬ D ⊆ T, ∏ v ∈ D, a v
      = (∏ v ∈ U ∩ T, (1 + a v)) * ((∏ v ∈ U \ T, (1 + a v)) - 1) := by
    rw [mul_sub, mul_one, hUT]
    linarith
  rw [key]
  have hA : ∏ v ∈ U ∩ T, (1 + a v) ≤ Real.exp S :=
    (Real.prod_one_add_le_exp_sum _ ha0).trans
      (Real.exp_le_exp.mpr (hsum.sum_le_tsum _ (fun v _ => ha0 v)))
  have hB1 : 1 ≤ ∏ v ∈ U \ T, (1 + a v) := by
    have := Finset.prod_le_prod₀ (s := U \ T) (f := fun _ => (1 : ℝ)) (g := fun v => 1 + a v)
      (fun _ _ => zero_le_one) (fun v _ => by linarith [ha0 v])
    simpa using this

  have hdisj : Disjoint (U \ T) T₀ :=
    Finset.disjoint_left.mpr fun v hv hv0 => (Finset.mem_sdiff.mp hv).2 (hT hv0)
  have htail : ∑ v ∈ U \ T, a v < ε := hT₀ _ hdisj
  have hB : ∏ v ∈ U \ T, (1 + a v) ≤ 1 + η / Real.exp S := by
    rw [← hexpε]
    exact (Real.prod_one_add_le_exp_sum _ ha0).trans (Real.exp_le_exp.mpr htail.le)
  calc (∏ v ∈ U ∩ T, (1 + a v)) * ((∏ v ∈ U \ T, (1 + a v)) - 1)
      ≤ Real.exp S * (η / Real.exp S) :=
        mul_le_mul hA (by linarith) (by linarith) hexpS.le
    _ = η := by field_simp

end GlobalTheory.CompanionTheory.Mass.MeanV
end

-- bundled from Development.AutomorphicSpectrum.Proofs.BlockDecomposition.TubeTransformIndependentOfBase
section
open MeasureTheory Filter Topology PositivityTheory.RgEis GlobalTheory.CompanionTheory.TubeFourier

namespace GlobalTheory.CompanionTheory.TubeFourier

theorem phi_eq_of_convex : ∀ (X : Type) [NormedAddCommGroup X] [NormedSpace ℂ X] [CompleteSpace X]
    (Ω : Set (ℝ × ℝ)) (G : ℂ × ℂ → X), IsOpen Ω → Convex ℝ Ω → GaussTube G Ω →
    ∀ x ∈ Ω, ∀ x' ∈ Ω, ∀ t : ℝ × ℝ, phi G x t = phi G x' t := by
  intro X _ _ _ Ω G hΩ hconv hG x hx x' hx' t
  have hhor : ∀ a b c : ℝ, (∀ s ∈ Set.uIcc a b, (s, c) ∈ Ω) →
      GlobalTheory.CompanionTheory.TubeFourier.phi G (a, c) t = GlobalTheory.CompanionTheory.TubeFourier.phi G (b, c) t := by
    intro a b c h
    rcases le_total a b with hab | hba
    · exact _root_.GlobalTheory.CompanionTheory.TubeFourier.phi_shift_fst X Ω G hG a b c hab
        (fun s hs => h s (Set.Icc_subset_uIcc hs)) t
    · exact (_root_.GlobalTheory.CompanionTheory.TubeFourier.phi_shift_fst X Ω G hG b a c hba
        (fun s hs => h s (Set.Icc_subset_uIcc' hs)) t).symm
  have hver : ∀ a b c : ℝ, (∀ s ∈ Set.uIcc a b, (c, s) ∈ Ω) →
      GlobalTheory.CompanionTheory.TubeFourier.phi G (c, a) t = GlobalTheory.CompanionTheory.TubeFourier.phi G (c, b) t := by
    intro a b c h
    rcases le_total a b with hab | hba
    · exact GlobalTheory.T.tube_transform_vertical_invariance X Ω G hG a b c hab
        (fun s hs => h s (Set.Icc_subset_uIcc hs)) t
    · exact (GlobalTheory.T.tube_transform_vertical_invariance X Ω G hG b a c hba
        (fun s hs => h s (Set.Icc_subset_uIcc' hs)) t).symm
  have hf : IsLocallyConstant (fun p : Ω => GlobalTheory.CompanionTheory.TubeFourier.phi G (p : ℝ × ℝ) t) := by
    rw [IsLocallyConstant.iff_eventually_eq]
    rintro ⟨⟨p₁, p₂⟩, hp⟩
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hΩ (p₁, p₂) hp
    have hmem : {q : Ω | (q : ℝ × ℝ) ∈ Metric.ball (p₁, p₂) ε} ∈ 𝓝 (⟨(p₁, p₂), hp⟩ : Ω) :=
      continuousAt_subtype_val.preimage_mem_nhds (Metric.ball_mem_nhds _ hε)
    filter_upwards [hmem]
    rintro ⟨⟨q₁, q₂⟩, hq⟩ hqball
    have hd : dist q₁ p₁ < ε ∧ dist q₂ p₂ < ε := by
      have h' : dist (q₁, q₂) (p₁, p₂) < ε := hqball
      rwa [Prod.dist_eq, max_lt_iff] at h'
    obtain ⟨h₁, h₂⟩ := hd
    rw [Real.dist_eq] at h₁ h₂
    have hv : GlobalTheory.CompanionTheory.TubeFourier.phi G (q₁, p₂) t = GlobalTheory.CompanionTheory.TubeFourier.phi G (q₁, q₂) t := by
      refine hver p₂ q₂ q₁ (fun s hs => hball ?_)
      rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff, Real.dist_eq, Real.dist_eq]
      exact ⟨h₁, lt_of_le_of_lt (Set.abs_sub_left_of_mem_uIcc hs) h₂⟩
    have hh : GlobalTheory.CompanionTheory.TubeFourier.phi G (p₁, p₂) t = GlobalTheory.CompanionTheory.TubeFourier.phi G (q₁, p₂) t := by
      refine hhor p₁ q₁ p₂ (fun s hs => hball ?_)
      rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff, dist_self, Real.dist_eq]
      exact ⟨lt_of_le_of_lt (Set.abs_sub_left_of_mem_uIcc hs) h₁, hε⟩
    show GlobalTheory.CompanionTheory.TubeFourier.phi G (q₁, q₂) t = GlobalTheory.CompanionTheory.TubeFourier.phi G (p₁, p₂) t
    rw [← hv, ← hh]
  haveI : PreconnectedSpace Ω := Subtype.preconnectedSpace hconv.isPreconnected
  exact hf.apply_eq_of_isPreconnected isPreconnected_univ (Set.mem_univ (⟨x, hx⟩ : Ω))
    (Set.mem_univ (⟨x', hx'⟩ : Ω))

end GlobalTheory.CompanionTheory.TubeFourier
end

