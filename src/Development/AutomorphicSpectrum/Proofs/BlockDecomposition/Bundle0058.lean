  have hc' := Subgroup.mem_prod.1 hc
  have hu₁ : left ρ c₁ u = u := hu (c₁, 1) (Subgroup.mem_prod.2 ⟨hc'.1, K₂.one_mem⟩)
  have hu₂ : ∀ k ∈ K₂, right ρ k u = u := fun k hk =>
    hu (1, k) (Subgroup.mem_prod.2 ⟨K₁.one_mem, hk⟩)
